# Copy to .env and fill in. Never commit .env.
# A provider is active when its key (or base URL) is set. Set one or more.

# --- OpenAI (Responses API) ---
# Your OpenAI API key; activates the openai provider.
OPENAI_API_KEY=
# Comma separated model names (default gpt-6-luna; the older single OPENAI_MODEL still works).
# OPENAI_MODELS=gpt-6-luna

# --- Anthropic (Claude, Messages API) ---
# Your Anthropic API key; activates the anthropic provider.
ANTHROPIC_API_KEY=
# Comma separated model names (default claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5).
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# --- OpenAI-compatible endpoint (Chat Completions) ---
# Base URL of the endpoint; active together with COMPATIBLE_MODELS.
# COMPATIBLE_BASE_URL=
# Comma separated model names served by that endpoint.
# COMPATIBLE_MODELS=
# API key for the endpoint (leave empty for local servers that need none).
# COMPATIBLE_API_KEY=
# Label shown in the model picker (default Compatible).
# COMPATIBLE_NAME=
#
# Example, OpenRouter:
# COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# COMPATIBLE_MODELS=meta-llama/llama-4-maverick,mistralai/mistral-large
# COMPATIBLE_API_KEY=sk-or-...
# COMPATIBLE_NAME=OpenRouter
#
# Example, Ollama on this machine:
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# COMPATIBLE_MODELS=llama3.2,qwen2.5
# COMPATIBLE_NAME=Ollama

# --- opencode (a local `opencode serve`, using whatever model access your opencode has) ---
# Run `opencode serve`, then set its address here (it prints the address and its password).
# OPENCODE_URL=http://127.0.0.1:49374
# The password `opencode serve` printed, or the one you set with OPENCODE_PASSWORD when starting it.
# OPENCODE_PASSWORD=
# prompt-tree adds its own plain-assistant agent for its sessions; nothing to configure in opencode.
# Comma separated opencode model names (provider/model); default: opencode's default model only.
# OPENCODE_MODELS=openai/gpt-6-luna,anthropic/claude-sonnet-5-5

# --- General ---
# Model id used by default, as <provider>:<model name> (default: first model of the first active provider).
# DEFAULT_MODEL=openai:gpt-6-luna
# Server port (default 8787; the Vite proxy follows it).
# PORT=8787
# Placeholder answers from two demo models, no key needed (`pnpm dev:demo` sets it for you).
# DEMO_MODE=1
