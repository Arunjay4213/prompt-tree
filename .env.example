# Settings for prompt-tree with real models.
# Demo mode (`pnpm dev:demo`) needs none of this: no file, no key.
# To use real models: copy this file to .env (`cp .env.example .env`), fill in at least one provider below, then run `pnpm dev`.
# A provider is active when its key (or base URL) is set. You can set several and pick the model per message.
# Lines that start with # are ignored. Never commit .env.

# --- OpenAI (Responses API) ---
# Your OpenAI API key. Setting it turns on the OpenAI provider.
OPENAI_API_KEY=
# Optional. Comma separated model names (default gpt-6-luna; the older single OPENAI_MODEL still works).
# OPENAI_MODELS=gpt-6-luna

# --- Anthropic (Claude, Messages API) ---
# Your Anthropic API key. Setting it turns on the Anthropic provider.
ANTHROPIC_API_KEY=
# Optional. Comma separated model names (default claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5).
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# --- Any OpenAI-compatible endpoint (Chat Completions) ---
# Base URL of the endpoint. The provider turns on when this and COMPATIBLE_MODELS are both set.
# COMPATIBLE_BASE_URL=
# Comma separated model names that endpoint serves.
# COMPATIBLE_MODELS=
# Optional. API key for the endpoint (leave empty for local servers that need none).
# COMPATIBLE_API_KEY=
# Optional. Label shown in the model picker (default Compatible).
# COMPATIBLE_NAME=
#
# Example, OpenRouter:
# COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# COMPATIBLE_MODELS=meta-llama/llama-4-maverick,mistralai/mistral-large
# COMPATIBLE_API_KEY=sk-or-...
# COMPATIBLE_NAME=OpenRouter
#
# Example, Ollama on this machine:
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# COMPATIBLE_MODELS=llama3.2,qwen2.5
# COMPATIBLE_NAME=Ollama

# --- opencode (a local `opencode serve`, using whatever model access your opencode has) ---
# Address of your running `opencode serve` (it prints the address and its password when it starts).
# OPENCODE_URL=http://127.0.0.1:49374
# The password `opencode serve` printed, or the one you set with OPENCODE_PASSWORD when starting it.
# OPENCODE_PASSWORD=
# prompt-tree adds its own plain-assistant agent for its sessions; nothing to configure in opencode.
# Optional. Comma separated opencode model names (provider/model); default: opencode's default model only.
# OPENCODE_MODELS=openai/gpt-6-luna,anthropic/claude-sonnet-5-5

# --- General ---
# Optional. Model used by default, as <provider>:<model name> (default: first model of the first active provider).
# DEFAULT_MODEL=openai:gpt-6-luna
# Optional. Server port (default 8787; the web app's dev proxy follows it).
# PORT=8787
# Demo mode: recorded and sample answers from two demo models, no key and no network calls. `pnpm dev:demo` and `pnpm start:demo` turn it on with the server's --demo flag, so this line is only needed to make demo mode the default.
# DEMO_MODE=1
